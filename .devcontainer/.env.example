# ================================
# .env example
# ================================

# Keycloak
# Secret of the client configured in Keycloak, used for OAuth2/OpenID Connect authentication.
Keycloak__credentials__secret=xxx

# SQL Server
# Main connection string used in development.
ConnectionStrings__DefaultConnection=xxx

# LDAP
# Password associated with the LDAP user configured above.
Ldap__Marinha__Password=xxx

# ================================
# Instructions
# ================================
# 1. Create a file named ".env" in the project root.
# 2. Copy and paste these variables into the file.
# 3. Replace the placeholder values "xxx" with the actual values for your environment.
# 4. Ensure that docker-compose.yml references this file using "env_file".
# 5. ASP.NET Core will automatically read these variables via Configuration.
