{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nuget", "npm"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "keycloak authservices monorepo",
      "matchPackageNames": ["/^Keycloak\\.AuthServices\\./"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "groupName": "itext monorepo",
      "matchPackageNames": ["/^itext(\\.|$)/"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "groupName": "coverlet monorepo",
      "matchUpdateTypes": ["digest", "patch", "minor", "major"],
      "matchPackageNames": ["/^coverlet(\.|$)/"]
    },
    {
      "extends": ["monorepo:dotnet"],
      "groupName": "dotnet monorepo",
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    }
  ]
}
