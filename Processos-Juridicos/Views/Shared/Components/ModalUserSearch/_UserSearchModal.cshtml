<!-- Shared AD search modal (Bootstrap) -->
<div class="modal fade" id="adPickerModal" tabindex="-1" aria-labelledby="adPickerLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adPickerLabel">Procurar no AD</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input id="adSearchBox" class="form-control" placeholder="Nome, ID (sAMAccountName) ou email" />
                    <button id="adSearchBtn" class="btn btn-primary" type="button">Pesquisar</button>
                </div>

                <div id="adSearchStatus" class="text-muted mb-2"></div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>ID</th>
                                <th>Email</th>
                                <th>Unidade</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="adResultsBody">
                            <!-- Rows injected via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button id="adClearBtn" type="button" class="btn btn-outline-secondary">Limpar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>
