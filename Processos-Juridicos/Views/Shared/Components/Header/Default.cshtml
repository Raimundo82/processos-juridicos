@using System.Security.Claims
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

    var name = User?.FindFirst("name")?.Value
        ?? "Utilizador";
    var nii = User?.FindFirst("preferred_username")?.Value
        ?? "Utilizador";

    var photo = Url.Content("~/images/default-avatar.webp");
}

@if (isAuthenticated)
{
    <div class="d-flex align-items-center gap-2" >
        <div class="d-grid text-end">
            <span class="text-small d-none d-md-block">@name</span>
            <span class="text-small d-none d-md-block">@nii</span>
        </div>
        
        <a href="~/account/signout" class="avatar-wrapper">
            <img src="@photo" alt="Avatar de @nii" 
                 class="rounded-circle avatar-img" width="40" height="40" />
            <div class="avatar-overlay">
                <i class="bi bi-box-arrow-right text-danger fs-5"></i>
            </div>
        </a>
    </div>
}
