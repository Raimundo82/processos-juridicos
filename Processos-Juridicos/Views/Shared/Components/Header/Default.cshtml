@using System.Security.Claims
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

    var nii = User?.FindFirst(ClaimTypes.Name)?.Value
              ?? User?.FindFirst("preferred_username")?.Value
              ?? "Utilizador";

    var photo = Url.Content("/images/default-avatar.webp");
}

@if (isAuthenticated)
{
    <div class="d-flex align-items-center gap-2" >
        <span class="text-small">@nii</span>
        <img src="@photo" alt="Avatar de @nii" class="rounded-circle mr-2" width="40" height="40" />

        <a href="account/signin" class="btn text-danger">
            Terminar sessão
        </a>
    </div>
}

