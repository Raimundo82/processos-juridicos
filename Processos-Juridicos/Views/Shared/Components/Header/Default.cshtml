@model UserDataModel
@{
	var displayName = Model.DisplayName ?? "Utilizador";
	var photo = Model.PhotoBase64 ?? Url.Content("~/images/default-avatar.png");
}

<div class="d-flex align-items-center">
	@* <span>@displayName</span> *@
	<img src="@photo"
		alt="Avatar de @displayName"
		class="rounded-circle avatar" />
</div>
