@model AuthenticatedUserViewModel

@if (Model.IsAuthenticated)
{
    <div class="d-flex align-items-center gap-2">
        <div class="d-grid text-end">
            <span class="text-small d-none d-md-block">@Model.DisplayName</span>
            <span class="text-small d-none d-md-block">@Model.Nii</span>
        </div>

        <a href="~/account/signout" class="avatar-wrapper">
            <img src="@Model.Photo"
                 alt="Fotografia de @Model.Nii"
                 class="rounded-circle avatar-img"
                 width="40" height="40" />

            <div class="avatar-overlay">
                <i class="bi bi-box-arrow-right text-danger fs-5"></i>
            </div>
        </a>
    </div>
}
