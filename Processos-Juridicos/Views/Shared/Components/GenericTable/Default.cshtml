@model Processos_Juridicos.Models.GenericTableModel

@if (Model.Rows == null || !Model.Rows.Any())
{
    <div class="alert alert-info text-center">
        Não existem @ViewData["Title"]?.ToString()?.ToLower().
    </div>
}
else
{
    <table id="@Model.TableId" class="table table-striped table-hover">
        <thead>
            <tr>
                @foreach (var header in Model.Headers!)
                {
                    <th>@header</th>
                }
                @if (Model.ShowActions)
                {
                    <th>Ações</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr data-id="@row.Id">
                    @for (int i = 0; i < row.Cells.Count; i++)
                    {
                        <td data-property="@Model.ColumnKeys[i]">@row.Cells[i]</td>
                    }

                    @if (Model.ShowActions)
                    {
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-controller="@Model.Controller" asp-action="Delete" method="post" data-action="delete">
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="btn btn-danger js-delete-btn">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                                <a asp-controller="@Model.Controller" asp-action="Edit" asp-route-id="@row.Id"
                                   class="btn btn-warning" data-action="access-edit-form">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
