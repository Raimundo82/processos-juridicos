@using Processos_Juridicos.Utilities.TextManager;
@{
    var theme = Context.Request.Cookies["theme"];
    var darkClass = theme == "dark" ? "dark-mode" : "";
}

<!DOCTYPE html>
<html lang="en" class="@darkClass">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Processos Jurídicos</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap-icons-1.13.1/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontsource/prosto-one/latin.css" />
    <link rel="stylesheet" href="~/lib/fontsource/roboto/latin.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/select2-bootstrap-5-theme.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="@darkClass">
    <header>
        <partial name="_Header" />
    </header>

    @if (ViewData["LoginView"] as bool? != true)
    {
        <partial name="_Menu" />
    }

    <main role="main">
            @RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/datatables/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs5/dataTables.bootstrap5.js"></script>
    <script src="~/lib/font-awesome/js/all.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>

    <script src="~/js/dark-mode.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/initializeDataTable.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("NToastNotify")

</body>
</html>
