@using Processos_Juridicos.Utilities.TextManager;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Processos_Juridicos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Processos_Juridicos.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatable/dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap-icons-1.13.1/bootstrap-icons.min.css" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Optional: Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" integrity="sha512-xxxx" crossorigin="anonymous">


</head>
<body>
    <header>
        <partial name="_Header" />
    </header>
    <div class="container">
        <partial name="_Navbar" />
        <main role="main" class="pb-3">
                @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/datatable/dataTables.min.js" asp-append-version="true"></script>
    
    <!-- JavaScript for Night Mode -->
    <script>
        document.getElementById('nightModeToggle').addEventListener('click', function() {
          document.body.classList.toggle('bg-dark');
          document.body.classList.toggle('text-light');
          // Add additional logic here if needed, for example saving user preferences.
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("NToastNotify")
</body>
</html>
