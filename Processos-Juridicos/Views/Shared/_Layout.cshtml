@using Processos_Juridicos.Utilities.TextManager;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Processos Jurídicos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatable/dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap-icons-1.13.1/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontsource/prosto-one/latin.css" />
    <link rel="stylesheet" href="~/lib/fontsource/roboto/index.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" /> 
</head>

<body>
    <header>
        <partial name="_Header" />
    </header>

    @if (ViewData["LoginView"] as bool? != true)
    {
        <partial name="_Menu" />
    }

    <div class="container-lg my-3">
        <main role="main">
                @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/datatable/dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2/sweetalert2.js" asp-append-version="true"></script>
    <script src="~/lib/font-awesome/js/all.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    
    <script>
        document.getElementById('nightModeToggle').addEventListener('click', function() {
          document.body.classList.toggle('bg-dark');
          document.body.classList.toggle('text-light');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("NToastNotify")

</body>
</html>
