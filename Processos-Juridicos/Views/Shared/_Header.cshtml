<div class="container">
    <div class="d-flex justify-content-between align-items-center">
        <!-- Left: Logo -->
        <div>
            <img alt="Logo" style="max-height: 50px;">
        </div>

        <!-- Right: Title and Buttons -->
        <div class="d-flex align-items-center">
            <h1 class="h4 mb-0 me-3">Processos Jurídicos</h1>

			<!-- User Information -->
