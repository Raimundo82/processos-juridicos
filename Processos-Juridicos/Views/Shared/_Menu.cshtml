@using Processos_Juridicos.Settings
@using Processos_Juridicos.Utilities
@inject Microsoft.Extensions.Options.IOptions<EstatisticaOptions> EstatisticaOptions

<nav class="navbar navbar-expand-md menu-bar">
    <div class="container-fluid mx-lg-5 mx-0">
        <div class="offcanvas offcanvas-end" tabindex="-1" id="navbarOffcanvasLg" aria-labelledby="navbarOffcanvasLgLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Processos Jurídicos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav justify-content-start flex-grow-1 pe-3 gap-3">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Página Inicial</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Process" asp-action="List">Gestão de Processos</a>
                    </li>
                    
                    @if (User.IsDj())
                    {
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                                Direção Jurídica
                            </button>

                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Unit" asp-action="List">Unidades</a></li>
                                <li><a class="dropdown-item" asp-controller="ProcessState" asp-action="List">Estados</a></li>
                                <li><a class="dropdown-item" asp-controller="ProcessType" asp-action="List">Tipos de Processos</a></li>
                                <li><a class="dropdown-item" asp-controller="Sentence" asp-action="List">Sentenças</a></li>
                                <li><a class="dropdown-item" asp-controller="HarmedOrCasualty" asp-action="List">Categorias de Mortos/Feridos</a></li>
                                <li><a class="dropdown-item" asp-controller="Infringement" asp-action="List">Artigos Infringidos</a></li>
                                <li><a class="dropdown-item" asp-controller="AccidentType" asp-action="List">Tipos de Acidentes</a></li>
                                <li><a class="dropdown-item" asp-controller="MilitarySecurity" asp-action="List">Segurança Militar</a></li>
                                <li><a class="dropdown-item" asp-controller="CrimeType" asp-action="List">Tipos de Crime</a></li>
                                
                                @if (User.IsDjAdministration())
                                {
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="List">Permissões dos Utilizadores</a></li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               href="@EstatisticaOptions.Value.BaseUrl"
                               target="_blank">
                                Estatística
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</nav>
