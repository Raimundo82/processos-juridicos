@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de Unidades";
    int count = 1;
}

@model IEnumerable<UnitDto>

<div class="text-center">
    <h1 class="display-4">Unidades</h1>
</div>

<a asp-controller="Unit" asp-action="Create" class="btn btn-primary">Inserir Unidade</a>

<div>
    <table id="tableUnits" class="table table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>

                <th scope="col">@Html.DisplayNameFor(m => m.UnitName)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.UnitCode)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.UnitAcronym)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.Sector.SectorName)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr data-id="@item.UnitId" @(item.Enable ? "data-enable" : "")>
                    <th scope="col">@count</th>
                    <td data-property="name">@Html.DisplayFor(m => item.UnitName)</td>
                    <td data-property="code">@Html.DisplayFor(m => item.UnitCode)</td>
                    <td data-property="acronym">@Html.DisplayFor(m => item.UnitAcronym)</td>
                    <td data-property="sector">@Html.DisplayFor(m => item.Sector.SectorName)</td>

                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="Unit" asp-action="Delete" method="post" data-action="delete">
                                <input type="hidden" name="id" value="@item.UnitId">
                                <button type="submit" class="btn btn-danger js-delete-btn"></button>
                            </form>
                            <a asp-controller="Unit" asp-action="Edit" asp-route-id="@item.UnitId"
                                data-action="access-edit-form" class="btn btn-warning"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableUnits");
    </script>
}
