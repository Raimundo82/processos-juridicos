@using Processos_Juridicos.DTOs
@using Processos_Juridicos.Utilities
@model IEnumerable<UnitDto>
@{
    ViewData["Title"] = "Lista de Unidades";
    int count = 1;
}

<div class="container-fluid">
    <div class="mx-lg-5 my-3">

        <div class="card card-action mb-3">
            <div class="d-flex align-items-center justify-content-between">
                <h2>@ViewData["Title"]</h2>
                <a asp-controller="Unit" asp-action="Create" class="btn btn-primary">Inserir Unidade</a>
            </div>
        </div>

        <div class="card">
            <div id="tableLoader" class="d-flex justify-content-center my-5">
                <output class="spinner-border text-primary">
                    <span class="visually-hidden">A carregar...</span>
                </output>
            </div>

            <div id="tableContent" class="d-none">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table id="tableUnits" class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.UnitName)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.UnitAcronym)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.UnitCode)</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.ToList())
                                {
                                    <tr data-id="@item.UnitId" @(item.Enable ? "data-enable" : "")>
                                        <th scope="col">@count</th>
                                        <td data-property="name">@Html.DisplayFor(m => item.UnitName)</td>
                                        <td data-property="acronym">@Html.DisplayFor(m => item.UnitAcronym)</td>
                                        <td data-property="code">@Html.DisplayFor(m => item.UnitCode)</td>

                                        <td>
                                            <div class="d-flex gap-3">
                                                <a asp-controller="Unit" asp-action="Edit" asp-route-id="@item.UnitId"
                                                   data-action="access-edit-form" class="text-primary"><i class="bi bi-pencil-square"></i></a>

                                                @if (User.IsDjAdministration())
                                                {
                                                    <a class="text-danger btn-delete"
                                                            data-entity="a unidade"
                                                            data-name="@item.UnitAcronym"
                                                            data-id="@item.UnitId"
                                                            data-controller="Unit"
                                                            data-action="Delete">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    count++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else 
                {
                    <div class="text-center">
                        <span>Não existem unidades.</span>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@await Html.PartialAsync("ConfirmationModals/_DeleteModal")

@section Scripts {
    <script>
        createDataTable('#tableUnits');
    </script>
}
