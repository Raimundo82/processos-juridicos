@model Processos_Juridicos.DTOs.UnitDto;
@using Processos_Juridicos.DTOs;

@{
    ViewData["Title"] = "Criar Unidade";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <partial name="Shared/_Form" />

    <div class="form-group mt-3">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="List">Voltar à Lista</a>
    </div>
</form>

<partial name="~/Views/Shared/Components/ModalUserSearch/_UserSearchModal.cshtml" />

<script type="module" src="~/js/lookup-units.js" asp-append-version="true"></script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
