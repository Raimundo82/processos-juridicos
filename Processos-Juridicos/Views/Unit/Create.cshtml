@model Processos_Juridicos.DTOs.UnitDto;
@using Processos_Juridicos.DTOs;

@{
    ViewData["Title"] = "Criar Unidade";
}

<div class="container-lg my-3">
    <div class="card mb-3">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div class="card">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="Shared/_Form" />

            <div class="d-flex justify-content-center mb-4">
                <div class="form-group mt-3 text-center">
                    <input type="submit" value="@ViewData["Title"]" class="btn btn-primary me-2" />
                    <a asp-action="List" class="btn btn-secondary">Voltar à Lista</a>
                </div>
            </div>

        </form>
    </div>
</div>

<partial name="~/Views/Shared/Components/ModalUserSearch/_UserSearchModal.cshtml" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="module" src="~/js/lookup-units.js" asp-append-version="true"></script>
}
