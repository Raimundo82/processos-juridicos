@using Processos_Juridicos.Entities
@model Processos_Juridicos.DTOs.UnitDto;

<div class="row mb-3">
      <div class="col-lg-12">
        <div class="form-group mt-3">
            <label asp-for="UnitName" class="form-label"></label>
            <input asp-for="UnitName" class="form-control" />
            <span asp-validation-for="UnitName" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="form-group mt-3">
            <label asp-for="UnitAcronym" class="form-label"></label>
            <input asp-for="UnitAcronym" class="form-control" />
            <span asp-validation-for="UnitAcronym" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="form-group mt-3">
            <label asp-for="UnitCode" class="form-label"></label>
            <input asp-for="UnitCode" class="form-control" />
            <span asp-validation-for="UnitCode" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="form-group mt-3 form-check">
            <input asp-for="CanCompensate" class="form-check-input" type="checkbox" />
            <label asp-for="CanCompensate" class="form-check-label"></label>
            <span asp-validation-for="CanCompensate" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-12">
       <div class="form-group mt-3">
            <label for="responsible-users-container" class="form-label">Utilizadores responsáveis</label>
            <div class="input-group">
                <input type="text" id="responsible-users-visible" class="form-control" placeholder="Digita o NII do utilizador" />
                <button type="button"
                        class="btn btn-auto btn-primary ad-lookup-btn"
                        data-target-visible="responsible-users-visible"
                        data-target-hidden="responsible-users-container"
                        data-target-info="responsible-users-info">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <small id="responsible-users-info" class="form-text text-muted"></small>
            <div id="responsible-users-container" class="d-flex flex-wrap gap-2">
                @foreach (var user in Model?.ResponsibleUsers ?? Enumerable.Empty<User>())
                {
                    <span class="badge bg-primary m-1 d-inline-flex align-items-center">
                        <input type="hidden" name="ResponsibleUserIds" value="@user.UserNii" />
                        <span>@user.UserName</span>
                        <button type="button" class="btn-close btn-close-white ms-2" aria-label="Remove"
                                onclick="this.parentElement.remove()"></button>
                    </span>
                }
            </div>
            <span asp-validation-for="ResponsibleUserIds" class="text-danger"></span>
        </div>

    </div>
</div>
