@model Processos_Juridicos.DTOs.UnitDto;

<div class="form-group mt-3">
    <label asp-for="UnitName" for="unit-name" class="control-label">Nome da Unidade</label>
    <input id="unit-name" asp-for="UnitName" class="form-control" />
    <span asp-validation-for="UnitName" class="text-danger"></span>
</div>

<div class="form-group mt-3">
    <label asp-for="UnitCode" for="unit-code" class="control-label">Código da Unidade</label>
    <input asp-for="UnitCode" id="unit-code" class="form-control" />
    <span asp-validation-for="UnitCode" class="text-danger"></span>
</div>

<div class="form-group mt-3">
    <label asp-for="UnitAcronym" for="unit_acronym"class="control-label">Sigla da Unidade</label>
    <input asp-for="UnitAcronym" id="unit_acronym" class="form-control" />
    <span asp-validation-for="UnitAcronym" class="text-danger"></span>
</div>

<div class="form-group mt-3">
    <label for="sector-id" class="control-label">Setor</label>
    <select id="sector-id" asp-for="SectorId" asp-items="ViewBag.selectors" class="form-control">
        <option value="">Selecione um Setor</option>
    </select>
    <span asp-validation-for="SectorId" class="text-danger"></span>
</div>