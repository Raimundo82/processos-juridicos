@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de Tipos de Processos";
    int count = 1;
}

@model IEnumerable<ProcessTypeDto>

<div class="text-center">
    <h1 class="display-4">Tipos de processos</h1>
</div>

<a asp-controller="ProcessType" asp-action="Create" class="btn btn-primary">Inserir tipo de processo</a>

<div>
    <table id="tableStates" class="table table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().ProcessTypeName)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().Deadline)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.ProcessTypeName)</td>
                    <td>@Html.DisplayFor(m => item.Deadline)</td>
                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="ProcessType" asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@item.ProcessTypeId">
                                <button type="submit" class="btn btn-danger js-delete-btn"></button>
                            </form>
                            <a asp-controller="ProcessType" asp-action="Edit" asp-route-id="@item.ProcessTypeId"
                               class="btn btn-warning"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableStates");
    </script>
} 
