@model Processos_Juridicos.DTOs.ProcessTypeDto;

<div class="row mb-3">
    <div class="col-lg-12">
        <div class="form-group mt-3">
            <label asp-for="ProcessTypeName" class="form-label"></label>
            <input asp-for="ProcessTypeName" class="form-control" />
            <span asp-validation-for="ProcessTypeName" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-12">
        <div class="form-group mt-3">
            <label asp-for="Deadline" class="form-label"></label>
            <input asp-for="Deadline" class="form-control" type="number" pattern="^\d+$" inputmode="numeric"
                maxlength="9" title="Introduza apenas dígitos (0-9)." />
            <span asp-validation-for="Deadline" class="text-danger"></span>
        </div>
    </div>
</div>
