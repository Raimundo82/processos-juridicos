@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Tipos de Acidente";
    int count = 1;
}

@model IEnumerable<AccidentTypeDto>

<div class="text-center">
    <h1 class="display-4">Categorias de Mortos/Feridos</h1>
</div>

<button asp-controller="AccidentType" asp-action="CreateEdit" class="btn btn-primary">Inserir categoria de Morto/Ferido</button>

<div>
    <table id="tableAccidents" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().AccidentName)</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="col">@count</th>
                    <td>@Html.DisplayFor(m => item.AccidentName)</td>
                    
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableAccidents");
    </script>
} 