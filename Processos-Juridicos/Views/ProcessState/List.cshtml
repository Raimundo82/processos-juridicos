@using Processos_Juridicos.DTOs
@model IEnumerable<ProcessStateDto>
@{
    ViewData["Title"] = "Lista de Estados";
    int count = 1;
}

<div class="container-fluid">
    <div class="mx-lg-5 my-3">

        <div class="card mb-3">
            <div class="d-flex align-items-center justify-content-between">
                <h2>@ViewData["Title"]</h2>
            </div>
        </div>
    
        <div class="card">
            <div id="tableLoader" class="d-flex justify-content-center my-5">
                <output class="spinner-border text-primary">
                    <span class="visually-hidden">A carregar...</span>
                </output>
            </div>

            <div id="tableContent" class="d-none">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table id="tableStates" class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.First().StateName)</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.ToList())
                                {
                                    <tr data-id="@item.ProcessStateId">
                                        <th scope="col">@count</th>
                                        <td data-property="name">@Html.DisplayFor(m => item.StateName)</td>
                                    </tr>

                                    count++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <span>Não existem unidades.</span>
                    </div>
                }   
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import { createDataTable } from '/js/initializeDataTable.js';
        createDataTable('#tableStates');
    </script>
}
