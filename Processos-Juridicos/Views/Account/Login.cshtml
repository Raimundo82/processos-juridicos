@using Processos_Juridicos.ViewModels
@model LoginViewModel

@{
    ViewData["LoginView"] = true;
    ViewData["Title"] = "Login";
}
<div class="container-lg">
<div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 156px);">
    <div class="col-lg-4 col-md-6 col-12 mx-auto">
        <div class="card">
            <div class="card-body">
                <h1 class="card-title mb-4">Autenticação</h1>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Username" class="form-label"></label>
                        <div class="input-icon-wrapper icon-left">
                            <i class="bi bi-person-fill"></i>
                            <input asp-for="Username" class="form-control" placeholder="NII (Utilizador)" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-icon-wrapper icon-left">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Palavra-passe" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Entrar
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
