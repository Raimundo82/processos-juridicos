@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de Categorias de Mortos/Feridos";
}

@model IEnumerable<HarmedOrCasualtyDto>

<div class="text-center">
    <h1 class="display-4">Categorias de Mortos/Feridos</h1>
</div>

<a asp-controller="HarmedOrCasualty" asp-action="Create" class="btn btn-primary">Inserir categoria de Morto/Ferido</a>

<div>
    <table id="tableHarmedOrCasualty" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(m => m.First().CasualtyName)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr data-id="@item.CasualtyId">
                    <td data-property="name">@Html.DisplayFor(m => item.CasualtyName)</td>
                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="HarmedOrCasualty" asp-action="Delete" method="post" data-action="delete">
                                <input type="hidden" name="id" value="@item.CasualtyId">
                                <button type="submit" class="btn btn-danger js-delete-btn"></button>
                            </form>
                            <a asp-controller="HarmedOrCasualty" data-action="access-edit-form" asp-action="Edit" asp-route-id="@item.CasualtyId"
                               class="btn btn-warning"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script type="module">
        import { createDataTable } from '/js/initializeDataTable.js';
        createDataTable('#tableHarmedOrCasualty');
    </script>
} 
