@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de categorias de Mortos/Feridos";
    int count = 1;
}

@model IEnumerable<HarmedOrCasualtyDto>

<div class="text-center">
    <h1 class="display-4">Categorias de Mortos/Feridos</h1>
</div>

<button asp-controller="HarmedOrCasualty" asp-action="CreateEdit" class="btn btn-primary">Inserir categoria de Morto/Ferido</button>

<div>
    <table id="tableStates" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@count</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().CasualtiesId)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().CasualtiesName)</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.CasualtiesId)</td>
                    <td>@Html.DisplayFor(m => item.CasualtiesName)</td>

                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableStates");
    </script>
} 