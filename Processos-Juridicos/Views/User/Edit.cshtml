@model Processos_Juridicos.DTOs.UserDto;
@using Processos_Juridicos.DTOs;

@{
    ViewData["Title"] = "Editar Permissões do Utilizador";
}

<h1>@ViewData["Title"]</h1>

<div class="form-group mt-3">
    <label for="user-name" class="control-label">Nome do utilizador</label>
    <p id="user-name"><p />

</div>

<div class="form-group mt-3">
    <label asp-for="UserNii" for="user-nii" class="control-label">@Html.DisplayNameFor(m => m.UserNii)</label>
    <p id="user-nii" asp-for="UserNii">
        @(Model.UserNii)
    </p>
</div>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="OriginalUserNii" />

    <!-- If UserNii is not supposed to be edited directly, keep it hidden too -->
    <input type="hidden" asp-for="UserNii" />

    <span asp-validation-for="UserNii" class="text-danger"></span>

    <div class="form-group mt-3">
        <label for="role-id" class="control-label">@Html.DisplayNameFor(m => m.RoleId)</label>
        <select id="role-id" asp-for="RoleId" asp-items="ViewBag.Roles" class="form-control">
            <option value="">Selecione o tipo de permissão</option>
        </select>
        <span asp-validation-for="RoleId" class="text-danger"></span>
    </div>


    <div class="form-group mt-3">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="List">Voltar à Lista</a>
    </div>
</form>

<script src="~/js/user-name-finder.js"></script>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
