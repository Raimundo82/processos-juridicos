@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de Utilizadores";
    int count = 1;
}

@model IEnumerable<UserDto>

<div class="text-center">
    <h1 class="display-4">Permissões dos utilizadores</h1>
</div>

<a asp-controller="User" asp-action="Create" class="btn btn-primary">Adicionar permissão</a>

<div>
    <table id="tableUserRoles" class="table table-striped table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>

                <th scope="col">@Html.DisplayNameFor(m => m.UserNii)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.RoleId)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr data-id="@item.UserNii")>
                    <th scope="col">@count</th>
                    <td data-property="name">@Html.DisplayFor(m => item.UserNii)</td>
                    <td data-property="code">@Html.DisplayFor(m => item.UserRole!.RoleName)</td>

                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="User" asp-action="Delete" method="post" data-action="delete">
                                <input type="hidden" name="id" value="@item.UserNii">
                                <button type="submit" class="btn btn-danger js-delete-btn"></button>
                            </form>
                            <a asp-controller="User" asp-action="Edit" asp-route-id="@item.UserNii"
                               data-action="access-edit-form" class="btn btn-warning"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableUserRoles");
    </script>
}
