@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de categorias de acidentes em serviço";
    int count = 1;
}

@model IEnumerable<InfringementsDTO>

<div class="text-center">
    <h1 class="display-4">Categorias de Acidentes em Serviço</h1>
</div>

<button asp-controller="HarmedOrCasualties" asp-action="CreateEdit" class="btn btn-primary">Inserir Acidente em Serviço</button>

<div>
    <table id="tableStates" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@count</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().infringement_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().infringement_name)</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.infringement_id)</td>
                    <td>@Html.DisplayFor(m => item.infringement_name)</td>

                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTabe("#tableStates");
    </script>
} 