@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de Setores";
}

@model IEnumerable<SectorDto>

<div class="text-center">
    <h1 class="display-4">Setores</h1>
</div>

<a asp-controller="Sector" asp-action="Create" class="btn btn-primary">Inserir Setor</a>

<div>
    <table id="tableSectors" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(m => m.First().SectorName)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().SectorCode)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr data-id="@item.SectorId" @(item.Enable ? "data-enable" : "")>
                    <td data-property="name">@Html.DisplayFor(m => item.SectorName)</td>
                    <td data-property="code">@Html.DisplayFor(m => item.SectorCode)</td>
                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="Sector" asp-action="Delete" method="post" data-action="delete">
                                <input type="hidden" name="id" value="@item.SectorId">
                                <button type="submit" class="btn btn-danger js-delete-btn"></button>
                            </form>
                            <a asp-controller="Sector" asp-action="Edit" asp-route-id="@item.SectorId"
                                data-action="access-edit-form" class="btn btn-warning"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableSectors");
    </script>
}
