@model Processos_Juridicos.DTOs.SentenceDto;
@{
    ViewData["Title"] = "Editar Sentença";
}

<div class="container-lg my-3">
    <div class="card mb-3">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div class="card">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="SentenceId" />

            <partial name="Shared/_Form" />

            <div class="d-flex justify-content-center mb-4">
                <div class="form-group mt-3 text-center">
                    <a asp-action="List" class="btn btn-secondary">Voltar</a>
                    <input type="submit" value="Guardar" class="btn btn-primary me-2" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
