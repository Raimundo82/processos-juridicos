@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Sentenças";
}

@model IEnumerable<SentenceDto>

<div class="text-center">
    <h1 class="display-4">Sentenças</h1>
</div>

<a asp-controller="Sentence" asp-action="Create" class="btn btn-primary">Inserir tipo de acidente</a>

<div>
    <table id="tableSentences" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@Html.DisplayNameFor(m => m.First().SentenceName)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr data-id="@item.SentenceId">
                    <td data-property="name">@Html.DisplayFor(m => item.SentenceName)</td>
                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="Sentence" asp-action="Delete" method="post" data-action="delete">
                                <input type="hidden" name="id" value="@item.SentenceId">
                                <button type="submit" class="btn btn-danger js-delete-btn"></button>
                            </form>
                            <a asp-controller="Sentence" asp-action="Edit" asp-route-id="@item.SentenceId"
                                data-action="access-edit-form" class="btn btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableSentences");
    </script>
}
