@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de sentenças";
    int count = 1;
}

@model IEnumerable<SentenceDto>

<div class="text-center">
    <h1 class="display-4">Sentenças</h1>
</div>

<button asp-controller="Sentence" asp-action="Create" class="btn btn-primary">Inserir tipo de sentença</button>

<div>
    <table id="tableStates" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().SentenceName)</th>

            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.SentenceName)</td>

                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableStates");
    </script>
} 