@model ErrorViewModel

@{
    ViewData["Title"] = Model.ErrorCode;
    int code = Model.ErrorCode;
}

<div class="container-lg">
    <div class="row justify-content-center align-items-center" style="min-height: 78vh;">
        <div class="col-lg-4 col-md-6 col-12 mx-auto">
            <div class="card">
                <div class="card-body text-center d-flex flex-column gap-3">
                    <i class="bi bi-x-circle-fill error-icon"></i>
                    @await Html.PartialAsync(Model.PartialViewName)
                    <a class="btn btn-secondary w-auto mx-auto" asp-controller="Home" asp-action="Index">Voltar</a>
                </div>
            </div>
        </div>
    </div>
</div>
