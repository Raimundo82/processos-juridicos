@{
    ViewData["LoginView"] = true;
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center">
    <div class="card shadow-sm" style="max-width: 400px; width: 100%;">
        <div class="card-body">
            <h4 class="card-title mb-4">Autenticação</h4>

            <form method="post" asp-action="Login">
                <div class="mb-3">
                    <label for="username" class="form-label">Utilizador</label>
                    <input type="text" class="form-control" id="username" name="username" placeholder="Digite o seu NII" required>
                </div>

                <div class="mb-3">
                    <label for="Password" class="form-label">Palavra-passe</label>
                    <input type="password" class="form-control" id="Password" name="Password" placeholder="Digite a sua palavra-passe" required>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Entrar</button>
                </div>
            </form>
        </div>
    </div>
</div>
