@model Processos_Juridicos.DTOs.ProcessDto
@using System.IO
@{
    Layout = null;
    ViewData["Title"] = "Relatório do Processo " + (Model?.Nuipm ?? "N/A");
}

<!DOCTYPE html>
<html lang="pt" xml:lang="pt">

<head>
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/fontsource/prosto-one/latin.css" />
    <link rel="stylesheet" href="lib/fontsource/roboto/latin.css" />
    <link rel="stylesheet" href="css/site.css" asp-append-version="true" />

    <style>
        @@page {
        margin-top: 60pt;
        margin-right: 36pt;
        margin-bottom: 50pt;
        margin-left: 36pt;
        }
        body {
            margin: 0;
        }
    </style>
</head>

<body>

    <h1 class="doc-title">Relatório do Processo: @(Model?.Nuipm ?? "N/A")</h1>

    <h2 class="doc-subtitle">Detalhes Principais</h2>
    <div class="data-grid">
        <div class="data-row">
            <div class="data-label">NUIPM:</div>
            <div class="data-value">@(Model?.Nuipm ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Tipo de Processo:</div>
            <div class="data-value">@(Model?.ProcessType?.ProcessTypeName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Estado:</div>
            <div class="data-value">@(Model?.ProcessState?.StateName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Unidade:</div>
            <div class="data-value">@(Model?.Unit?.UnitName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Data da Ocorrência:</div>
            <div class="data-value">@(Model?.OcurrenceDate?.ToString("dd/MM/yyyy") ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Prazo Previsto para Encerramento:</div>
            <div class="data-value">@(Model?.DeadlineDate?.ToString("dd/MM/yyyy") ?? "N/A")</div>
        </div>
    </div>

    <h2 class="doc-subtitle">Oficial Instrutor</h2>
    <div class="data-grid">
        <div class="data-row">
            <div class="data-label">Oficial Instrutor:</div>
            <div class="data-value">@(Model?.OficialInstName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Oficial Instrutor Nii:</div>
            <div class="data-value">@(Model?.OficialInstNii ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Telefone do Oficial Instrutor:</div>
            <div class="data-value">@(Model?.OficialInstTelephone ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Data de Despacho de Nomeação:</div>
            <div class="data-value">@(Model?.DispatchDate?.ToString("dd/MM/yyyy") ?? "N/A")</div>
        </div>
    </div>

    <h2 class="doc-subtitle">Informações do Averiguado</h2>
    <div class="data-grid">
        <div class="data-row">
            <div class="data-label">Averiguado:</div>
            <div class="data-value">@(Model?.InvestigatedName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Sexo do Averiguado:</div>
            <div class="data-value">@(Model?.InvestigatedGender ?? "N/A")</div>
        </div>
    </div>

    <h2 class ="doc-subtitle">Descrição da Ocorrência</h2>
    <div class="description-box">
        @Model?.Description
    </div>

    <h2 class="doc-subtitle">Encerramento e Penalidades</h2>
    <div class="data-grid">
        <div class="data-row">
            <div class="data-label">Data de Despacho Final:</div>
            <div class="data-value">@(Model?.FinalDispatchDate?.ToString("dd/MM/yyyy") ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Pena Aplicada:</div>
            <div class="data-value">@(Model?.Sentence?.SentenceName ?? "N/A")</div>
        </div>

        @if (Model?.InfringementDetails?.Count > 0)
        {
            <div class="data-row">
                <div class="data-label">Artigos Infringidos:</div>
                <div class="data-value">
                    @string.Join(", ", Model.InfringementDetails.Select(i => i.InfringementName))
                </div>
            </div>
        }
        else
        {
            <div class="data-row">
                <div class="data-label">Artigos Infringidos:</div>
                <div class="data-value">N/A</div>
            </div>
        }
    </div>

    <h2 class="doc-subtitle">Valores e Compensação</h2>
    <div class="data-grid">
        <div class="data-row">
            <div class="data-label">Valor Indemnizado a Terceiros:</div>
            <div class="data-value">
                @(Model?.ThirdPartyCompensation.HasValue == true
                    ? $"{Model.ThirdPartyCompensation.Value.ToString("N2")} €"
                    : "N/A")
            </div>

        </div>
        <div class="data-row">
            <div class="data-label">Valor Ressarcido à Marinha:</div>
            <div class="data-value">
                @(Model?.Reimbursement != null && Model.Reimbursement.ToString() != "N/A"
                    ? $"{Model.Reimbursement.Value.ToString("N2")} €"
                    : "N/A")
            </div>
        </div>
        <div class="data-row">
            <div class="data-label">Compensação Paga:</div>
            <div class="data-value">@(Model?.CompensationPaid == true ? "Sim" : "Não")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Unidade Compensadora:</div>
            <div class="data-value">@(Model?.CompensatingUnit?.UnitName ?? "N/A")</div>
        </div>
    </div>

    <h2 class="doc-subtitle">Ocorrência e Descrição</h2>
    <div class="data-grid">
        <div class="data-row">
            <div class="data-label">Tipo de Crime:</div>
            <div class="data-value">@(Model?.CrimeType?.CrimeTypeName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Segurança Militar:</div>
            <div class="data-value">@(Model?.MilitarySecurity?.MilitarySecurityName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Acidente em Serviço:</div>
            <div class="data-value">@(Model?.AccidentType?.AccidentTypeName ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Morto/Ferido:</div>
            <div class="data-value">@(Model?.HarmedOrCasualties?.CasualtyName ?? "N/A")</div>
        </div>
    </div>

    <h2 class="doc-subtitle">Comunicação e Auditoria</h2>
    <div class="data-grid">
        <div class="data-row">
            <div class="data-label">Comunicado à PJM:</div>
            <div class="data-value">@(Model?.ComunicatedToPjm == true ? "Sim" : "Não")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Data da Comunicação à PJM:</div>
            <div class="data-value">@(Model?.ComunicationDate?.ToString("dd/MM/yyyy") ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Data de Criação:</div>
            <div class="data-value">@(Model?.CreatedAt?.ToString("dd/MM/yyyy") ?? "N/A")</div>
        </div>
        <div class="data-row">
            <div class="data-label">Criado por:</div>
            <div class="data-value">@Model?.CreatedByName (@Model?.CreatedByNii)</div>
        </div>
    </div>

</body>

</html>
