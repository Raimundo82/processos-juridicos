@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de processos";
    int count = 1;
}

@model IEnumerable<ProcessesDTO>

<div class="text-center">
    <h1 class="display-4">Processos</h1>
</div>

<button asp-controller="Processes" asp-action="CreateEdit" class="btn btn-primary">Inserir Processo</button>

<div class="table-responsive-md" style="max-width: calc(100vw-200px);margin: 0 auto; overflow-x: auto;">
    <table id="tableStates" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@count</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().process_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().nuipm)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().process_type_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().oficial_inst_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().investigated_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().investigated_gender_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().occurrence_date)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().dispatch_date)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().description)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().deadline_date)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().final_dispatch_date)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().sentence_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().state_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().created_at)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().created_by_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().modified_at)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().modified_by_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().service_accident_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().harmed_or_casualties_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().third_party_compensation)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().reimbursement)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().infringement_id)</th>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.process_id)</td>
                    <td>@Html.DisplayFor(m => item.nuipm)</td>
                    <td>@Html.DisplayFor(m => item.process_type_id)</td>
                    <td>@Html.DisplayFor(m => item.unit_id)</td>
                    <td>@Html.DisplayFor(m => item.oficial_inst_id)</td>
                    <td>@Html.DisplayFor(m => item.investigated_id)</td>
                    <td>@Html.DisplayFor(m => item.investigated_gender_id)</td>
                    <td>@Html.DisplayFor(m => item.occurrence_date)</td>
                    <td>@Html.DisplayFor(m => item.dispatch_date)</td>
                    <td>@Html.DisplayFor(m => item.description)</td>
                    <td>@Html.DisplayFor(m => item.deadline_date)</td>
                    <td>@Html.DisplayFor(m => item.final_dispatch_date)</td>
                    <td>@Html.DisplayFor(m => item.sentence_id)</td>
                    <td>@Html.DisplayFor(m => item.state_id)</td>
                    <td>@Html.DisplayFor(m => item.created_at)</td>
                    <td>@Html.DisplayFor(m => item.created_by_id)</td>
                    <td>@Html.DisplayFor(m => item.modified_at)</td>
                    <td>@Html.DisplayFor(m => item.modified_by_id)</td>
                    <td>@Html.DisplayFor(m => item.service_accident_id)</td>
                    <td>@Html.DisplayFor(m => item.harmed_or_casualties_id)</td>
                    <td>@Html.DisplayFor(m => item.third_party_compensation)</td>
                    <td>@Html.DisplayFor(m => item.reimbursement)</td>
                    <td>@Html.DisplayFor(m => item.infringement_id)</td>

                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTabe("#tableStates");
    </script>
} 