@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de tipos de processos";
    int count = 1;
}

@model IEnumerable<Process_typesDTO>

<div class="text-center">
    <h1 class="display-4">Tipos de processos</h1>
</div>

<button asp-controller="ProcessTypes" asp-action="CreateEdit" class="btn btn-primary">Inserir tipo de processo</button>

<div>
    <table id="tableStates" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@count</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().process_type_id)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().process_name)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().deadline)</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.process_type_id)</td>
                    <td>@Html.DisplayFor(m => item.process_name)</td>
                    <td>@Html.DisplayFor(m => item.deadline) dias</td>

                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTabe("#tableStates");
    </script>
} 