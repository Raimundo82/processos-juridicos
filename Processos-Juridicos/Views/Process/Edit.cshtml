@model Processos_Juridicos.DTOs.ProcessDto;
@using Processos_Juridicos.Utilities

@{
    ViewData["Title"] = "Editar Processo";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="ProcessId" />

    <partial name="Shared/_Form" />

    @if (User.IsDj())
    {
        <partial name="Shared/_AdminForm" />
    }

    <div class="form-group mt-3">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="List">Voltar à Lista</a>
    </div>
</form>

<script src="~/js/forms.js" asp-append-version="true"></script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
