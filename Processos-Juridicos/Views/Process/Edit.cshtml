@model Processos_Juridicos.DTOs.ProcessDto;
@using Processos_Juridicos.Utilities

@{
    ViewData["Title"] = "Editar Processo";
}

<div class="card mb-3">
    <h2>@ViewData["Title"]</h2>
</div>

<div class="card">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="ProcessId" />

        <partial name="Shared/_Form" />

        @if (User.IsDj())
        {
            <partial name="Shared/_AdminForm" />
        }

        <div class="d-flex justify-content-center mb-4">
            <div class="form-group mt-3 text-center">
                <input type="submit" value="Guardar" class="btn btn-primary me-2" />
                <a asp-action="List" class="btn btn-outline-secondary">Voltar à Lista</a>
            </div>
        </div>

    </form>
</div>

<script src="~/js/forms.js" asp-append-version="true"></script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
