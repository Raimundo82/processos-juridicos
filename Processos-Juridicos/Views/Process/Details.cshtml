@using Processos_Juridicos.DTOs;
@model Processos_Juridicos.DTOs.ProcessDto;



<h2>Process Details</h2>

<div>
    <dl class="row main-data">
        <dt class="col-sm-2">
            NUIPM
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nuipm)
        </dd>

        <dt class="col-sm-2">
            Tipo de Processo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProcessType.ProcessTypeName)
        </dd>

        <dt class="col-sm-2">
            Unidade
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Unit.UnitName)
        </dd>

        <dt class="col-sm-2">
            Oficial Instrutor
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OficialInstName)
        </dd>

        <dt class="col-sm-2">
            Telefone
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OficialInstTelephone)
        </dd>

        <dt class="col-sm-2">
            Averiguado
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.InvestigatedName)
        </dd>

        <dt class="col-sm-2">
            Sexo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.InvestigatedGender)
        </dd>

        <dt class="col-sm-2">
            Data de Abertura do Processo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComunicationDate)
        </dd>

        <dt class="col-sm-2">
            Data da Ocorrência
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OcurrenceDate)
        </dd>

        <dt class="col-sm-2">
            Data de Despacho de Nomeação do Instrutor
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DispatchDate)
        </dd>

        <dt class="col-sm-2">
            Descrição da Ocorrência
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt class="col-sm-2">
            Prazo Previsto para encerramento por parte do Of. Instrutor (Inicial / Prorrogação)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt class="col-sm-2">
            Data de Despacho Final do Com./Dir./Chefe
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FinalDispatchDate)
        </dd>

        <dt class="col-sm-2">
            Pena Aplicada
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Sentence.SentenceName)
        </dd>

        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProcessState.StateName)
        </dd>

        <dt class="col-sm-2">
            Anexos
        </dt>
        <dd class="col-sm-10">

        </dd>
    </dl>

    <dl class="row dj-exclusive-data bg-primary bg-gradient">
        <dt class="col-sm-2">
            Acidente em Serviço
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AccidentType.AccidentTypeName)
        </dd>

        <dt class="col-sm-2">
            Mortos/Feridos
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.HarmedOrCasualties.CasualtyName)
        </dd>

        <dt class="col-sm-2">
            Valor Indemnizado a Terceiros
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ThirdPartyCompensation)
        </dd>

        <dt class="col-sm-2">
            Valor Ressarcido à Marinha
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reimbursement)
        </dd>

        <dt class="col-sm-2">
            Artigos Infringidos
        </dt>
        <dd class="col-sm-10">
            @(Model.InfringementDetails != null && Model.InfringementDetails.Any()
                ? string.Join(", ", Model.InfringementDetails.Select(i => i.InfringementName))
                : "Nenhum artigo infringido")
        </dd>

        <dt class="col-sm-2">
            Tipo de crime
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CrimeType.CrimeTypeName)
        </dd>

        <dt class="col-sm-2">
            Segurança Militar
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MilitarySecurity.MilitarySecurityName)
        </dd>

        <dt class="col-sm-2">
            Compensação paga pela unidade?
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CompensationPaid)
        </dd>

        <dt class="col-sm-2">
            Unidade responsável pela compensação
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CompensatingUnit.UnitAcronym)
        </dd>

        <dt class="col-sm-2">
            Comunicado à PJM?
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComunicatedToPjm)
        </dd>

        <dt class="col-sm-2">
            Data de comunicação à PJM
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ComunicationDate)
        </dd>

    </dl>
</div>

<div>
    <a asp-action="List">Back to List</a>
</div>
