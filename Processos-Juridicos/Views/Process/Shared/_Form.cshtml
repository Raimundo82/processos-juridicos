@model Processos_Juridicos.DTOs.ProcessDto

<div class="row mb-3">
    <div class="col-lg-4 col-md-6">
        <div class="form-group mt-3">
            <label asp-for="Nuipm" class="form-label"></label>
            <input asp-for="Nuipm" class="form-control" readonly />
            <span class="form-text">Gerado automaticamente</span>
            <span asp-validation-for="Nuipm" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="form-group mt-3">
            <label asp-for="ProcessTypeId" class="form-label"></label>
            <select asp-for="ProcessTypeId" asp-items="ViewBag.processTypes" class="form-select">
                <option value="">Selecione um tipo</option>
            </select>
            <span asp-validation-for="ProcessTypeId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="UnitId" class="form-label"></label>
            <select asp-for="UnitId" asp-items="ViewBag.units" class="form-select">
                <option value="">Selecione uma unidade</option>
            </select>
            <span asp-validation-for="UnitId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-8 col-md-12">
        <div class="form-group mt-3">
            <input type="hidden" asp-for="OficialInstName" />
            <input type="hidden" asp-for="OficialInstNii" />

            <label asp-for="OficialInstName" class="form-label"></label>
            <div class="input-group">
                <input id="instructor-lookup"
                       class="form-control"
                       placeholder="Digite o ID do oficial, ex: a1234"
                       value="@(string.Join(" - ",
                                      new[] { Model?.OficialInstName, Model?.OficialInstNii }
                                          .Where(s => !string.IsNullOrWhiteSpace(s))))" />

                <button type="button"
                        class="btn btn-primary btn-auto ad-lookup-btn"
                        data-target-visible="instructor-lookup"
                        data-target-hidden="OficialInstName"
                        data-target-hidden2="OficialInstNii"
                        data-target-info="OficialInstInfo">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <span id="OficialInstInfo" class="form-text"></span>
            <span asp-validation-for="OficialInstNii" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="OficialInstTelephone" class="form-label"></label>
            <div class="input-icon-wrapper icon-left">
                <i class="bi bi-telephone-fill"></i>
                <input asp-for="OficialInstTelephone" type="number" class="form-control" />
            </div>
            <span asp-validation-for="OficialInstTelephone" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-8 col-md-12">
        <div class="form-group mt-3">
            <input type="hidden" asp-for="InvestigatedName" />

            <label asp-for="InvestigatedName" class="form-label"></label>
            <div class="input-group">
                <input id="investigated-lookup" class="form-control" />
                <button type="button"
                        class="btn btn-primary btn-auto ad-lookup-btn"
                        data-target-visible="investigated-lookup"
                        data-target-hidden="InvestigatedName"
                        data-target-info="InvestigatedInfo">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <span id="InvestigatedInfo" class="form-text"></span>
            <span asp-validation-for="InvestigatedName" class="text-danger"></span>

            <div class="form-check mt-2">
                <input type="checkbox" id="uncertainInvestigated" class="form-check-input" />
                <label for="uncertainInvestigated" class="form-check-label">Averiguado incerto</label>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="InvestigatedGender" class="form-label"></label>
            <select asp-for="InvestigatedGender" asp-items="ViewBag.genders" class="form-select">
                <option value="">Selecione o género</option>
            </select>
            <span asp-validation-for="InvestigatedGender" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="CreatedAt" class="form-label"></label>
            <input asp-for="CreatedAt" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")"/>
            <span asp-validation-for="CreatedAt" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="OcurrenceDate" class="form-label"></label>
            <input asp-for="OcurrenceDate" type="date" class="form-control" />
            <span asp-validation-for="OcurrenceDate" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="DispatchDate" class="form-label"></label>
            <input asp-for="DispatchDate" type="date" class="form-control" />
            <span asp-validation-for="DispatchDate" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <div class="form-group mt-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4">
        <div class="form-group mt-3">
            <label asp-for="DeadlineDate" class="form-label"></label>
            <input asp-for="DeadlineDate" type="date" class="form-control" />
            <span asp-validation-for="DeadlineDate" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="form-group mt-3">
            <label asp-for="FinalDispatchDate" class="form-label"></label>
            <input asp-for="FinalDispatchDate" type="date" class="form-control" />
            <span asp-validation-for="FinalDispatchDate" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4">
        <div class="form-group mt-3">
            <label asp-for="SentenceId" class="form-label"></label>
            <select asp-for="SentenceId" asp-items="ViewBag.sentences" class="form-select">
                <option value="">Selecione uma sentença</option>
            </select>
            <span asp-validation-for="SentenceId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4">
        <div class="form-group mt-3">
            <label asp-for="ProcessStateId" class="form-label"></label>
            <select asp-for="ProcessStateId" asp-items="ViewBag.states" class="form-select"></select>
            <span asp-validation-for="ProcessStateId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="form-group mt-3">
            <label class="form-label">Estado atual</label>
            <input class="form-control" value="@Model?.ProcessState?.StateName" readonly />
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4">
        <div class="form-group mt-3">
            <label asp-for="ProcessFiles" class="form-label">Anexos</label>
            <input type="file" asp-for="ProcessFiles" class="form-control" multiple />
            <span asp-validation-for="ProcessFiles" class="text-danger"></span>
        </div>
    </div>
</div>

@if (Model?.UploadedFiles?.Any() == true)
{
    <div class="row mb-3">
        <div class="col-lg-4">
            @await Html.PartialAsync("Shared/_FileList", Model.UploadedFiles, new ViewDataDictionary(ViewData) { { "AllowDelete", true } })
        </div>
    </div>
}

<div id="deletedFilesContainer"></div>

<partial name="~/Views/Shared/Components/ModalUserSearch/_UserSearchModal.cshtml" />

<script type="module" src="~/js/lookup.js"></script>

