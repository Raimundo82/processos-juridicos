@model IEnumerable<Processos_Juridicos.DTOs.ProcessFileDto>
@{
    bool allowDelete = ViewBag.AllowDelete ?? false;
}

<div class="d-grid gap-2">
    @foreach (var file in Model)
    {
        var extension = System.IO.Path.GetExtension(file.ProcessFileTrustedName)?.ToLower();
        string iconClass = "bi-file-earmark";
        
        if (extension == ".pdf")
        {
            iconClass = "bi-file-earmark-pdf text-danger";
        }
        else if (extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif")
        {
            iconClass = "bi-file-earmark-image text-primary";
        }
        else if (extension == ".doc" || extension == ".docx")
        {
            iconClass = "bi-file-earmark-word text-info";
        }

        <div class="card file-card" id="file-row-@file.ProcessFileId">
            <div class="card-body d-flex align-items-center gap-2">
                <i class="bi @iconClass" style="font-size: 1.2rem;"></i>

                <p class="m-0 flex-grow-1 text-truncate" title="@file.ProcessFileTrustedName">
                    @file.ProcessFileTrustedName
                </p>

                <div class="d-flex gap-2 ms-auto align-items-end">
                    <a asp-controller="ProcessFile" asp-action="DownloadFile" asp-route-id="@file.ProcessFileId" class="text-decoration-none text-primary" id="download-file" title="Descarregar">
                        <i class="bi bi-download"></i>
                    </a>

                    @if (allowDelete)
                    {
                        <button type="button"
                            class="btn btn-auto btn-link text-danger p-0 js-mark-for-deletion"
                            title="Eliminar"
                            data-file-id="@file.ProcessFileId">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    }

                </div>
            </div>
        </div>
    }
</div>
