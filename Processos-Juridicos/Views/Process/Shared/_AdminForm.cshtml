@using Processos_Juridicos.Entities
@model Processos_Juridicos.DTOs.ProcessDto;


<div class="mt-5 mb-3 d-grid gap-5">
    <div class="border-box"></div>
    <h2 class="text-center">A preencher pela Direção Jurídica após o "Fecho" do Processo</h2>
</div>


<div class="row mb-3">
    <div class="col-lg-4 col-md-12 offset-lg-2">
        <div class="form-group mt-3">
            <label asp-for="ServiceAccidentId" class="form-label"></label>
            <select asp-for="ServiceAccidentId" asp-items="ViewBag.accidentTypes" class="form-select">
                <option value="">Selecione o acidente</option>
            </select>
            <span asp-validation-for="ServiceAccidentId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="HarmedOrCasualtiesId" class="form-label"></label>
            <select asp-for="HarmedOrCasualtiesId" asp-items="ViewBag.casualties" class="form-select">
                <option value="">Selecione a categoria</option>
            </select>
            <span asp-validation-for="HarmedOrCasualtiesId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4 col-md-12 offset-lg-2">
        <div class="form-group mt-3">
            <label asp-for="ThirdPartyCompensation" class="form-label"></label>
            <div class="input-icon-wrapper icon-left">
                <i class="bi bi-currency-euro"></i>
                <input asp-for="ThirdPartyCompensation" type="number" class="form-control" />
            </div>
            <span asp-validation-for="ThirdPartyCompensation" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="form-group mt-3">
            <label asp-for="Reimbursement" class="form-label"></label>
            <div class="input-icon-wrapper icon-left">
                <i class="bi bi-currency-euro"></i>
                <input asp-for="Reimbursement" type="number" class="form-control" />
            </div>
            <span asp-validation-for="Reimbursement" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-8 col-md-12 offset-lg-2">
        <div class="form-group mt-3">
            <label asp-for="Infringements" class="form-label"></label>
            <select asp-for="Infringements" asp-items="ViewBag.Infringements" multiple class="form-select"></select>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4 col-md-12 offset-lg-4">
        <div class="form-group mt-3">
            <div class="form-check mt-2">
                <input asp-for="ComunicatedToPjm" type="checkbox" class="form-check-input" />
                <label asp-for ="ComunicatedToPjm" class="form-check-label"></label>
            </div>
            <label asp-for="ComunicationDate" class="form-label"></label>
            <input asp-for="ComunicationDate" type="date" class="form-control" />
            <span asp-validation-for="ComunicationDate" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4 col-md-12 offset-lg-4">
        <div class="form-group mt-3">
            <label asp-for="CrimeTypeId" class="form-label"></label>
            <select asp-for="CrimeTypeId" asp-items="ViewBag.crimeTypes" class="form-select">
                <option value="">Selecione um tipo</option>
            </select>
            <span asp-validation-for="CrimeTypeId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4 col-md-12 offset-lg-4">
        <div class="form-group mt-3">
            <label asp-for="MilitarySecurityId" class="form-label"></label>
            <select asp-for="MilitarySecurityId" asp-items="ViewBag.militarySecurities" class="form-select">
                <option value="">Selecione uma opção</option>
            </select>
            <span asp-validation-for="MilitarySecurityId" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-lg-4 col-md-12 offset-lg-4">
        <div class="form-group mt-3">
            <label asp-for="CompensatingUnitId" class="form-label"></label>
            <select asp-for="CompensatingUnitId" asp-items="ViewBag.compensatingUnits" class="form-select">
                <option value="">Selecione uma unidade</option>
            </select>
            <span asp-validation-for="CompensatingUnitId" class="text-danger"></span>
        </div>
    </div>
</div>
