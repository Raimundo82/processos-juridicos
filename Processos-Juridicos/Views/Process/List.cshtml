@using Processos_Juridicos.Utilities
@model ProcessListViewModel
@{
    ViewData["Title"] = "Lista de Processos";
}

<div class="container-fluid">
    <div class="mx-lg-5 my-3">

        @if (Model.CanInsertProcess)
        {
            <div class="card card-action mb-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h2>@Model.Title</h2>
                    <a asp-controller="Process" asp-action="Create" class="btn btn-primary">Inserir Processo</a>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="d-flex align-items-center justify-content-between">
                    <h2>@Model.Title</h2>
                </div>
            </div>
        }

        <div class="card">
            <div id="tableLoader" class="d-flex justify-content-center my-5">
                <output class="spinner-border text-primary">
                    <span class="visually-hidden">A carregar...</span>
                </output>
            </div>

            <div id="tableContent" class="d-none">
                @if (Model.Processes != null && Model.Processes.Any())
                {
                
                    <div class="row mb-2">
                        <div class="col-lg-4 col-md-12">
                            <div class="form-group mt-3">
                                <select class="form-select" id="unitFilter">
                                    <option value="">Todas as unidades</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="form-group mt-3">
                                <select class="form-select" id="typeFilter">
                                    <option value="">Todos os tipos</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="form-group mt-3">
                                <select class="form-select" id="stateFilter">
                                    <option value="">Todos os estados</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="processesTable" class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().Nuipm)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().ProcessTypeId)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().UnitId)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().OficialInstName)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().OficialInstTelephone)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().CreatedAt)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().CreatedByName)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().Sentence)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().ProcessState)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().ModifiedAt)</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.Processes.First().ModifiedByName)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model.Processes.ToList())
                                {
                                    <tr data-id="@item.ProcessId">
                                        <td data-property="nuipm"><strong>@Html.DisplayFor(m => item.Nuipm)</strong></td>
                                        <td data-property="process-type">@(item.ProcessType?.ProcessTypeName ?? "-")</td>
                                        <td data-property="unit">@(item.Unit?.UnitAcronym ?? "-")</td>
                                        <td data-property="instructing-official">@Html.DisplayFor(m => item.OficialInstName)</td>
                                        <td data-property="instructing-official-phone">@Html.DisplayFor(m => item.OficialInstTelephone)</td>
                                        <td data-property="created-at">@Html.DisplayFor(m => item.CreatedAt)</td>
                                        <td data-property="created-by">@Html.DisplayFor(m => item.CreatedByName)</td>
                                        <td data-property="sentence"><strong>@(item.Sentence?.SentenceName ?? "-")</strong></td>
                                        <td data-property="state"><strong>@(item.ProcessState?.StateName ?? "-")</strong></td>
                                        <td data-property="last-modified-date">@(item.ModifiedAt?.ToString("dd-MM-yyyy") ?? "-")</td>
                                        <td data-property="last-modified-by">@(item.ModifiedByName?.ToString() ?? "-")</td>

                                        <td>
                                            <div class="d-flex gap-3">
                                                <a asp-controller="Process" asp-action="Details" asp-route-id="@item.ProcessId"
                                                   data-action="access-edit-form" class="text-primary"><i class="bi bi-search"></i></a>
                                                <a asp-controller="Process" asp-action="Edit" asp-route-id="@item.ProcessId"
                                                   data-action="access-edit-form" class="text-primary"><i class="bi bi-pencil-square"></i></a>

                                                @if (User.IsDjAdministration())
                                                {
                                                    <a class="text-danger btn-delete"
                                                            data-entity="o processo"
                                                            data-name="@item.Nuipm"
                                                            data-id="@item.ProcessId"
                                                            data-controller="Process"
                                                            data-action="Delete">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    @if (Model.HasRole) {
                        <div class="text-center">
                            <span>Não existem processos.</span>
                        </div>
                    }
                    else {
                        <div class="text-center">
                            <span>Não tem permissão para aceder a esta página.</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("ConfirmationModals/_DeleteModal")

@section Scripts {
    <script type="module">
        import { createDataTable } from '/js/initializeDataTable.js';

        createDataTable('#processesTable');
    </script>
}
