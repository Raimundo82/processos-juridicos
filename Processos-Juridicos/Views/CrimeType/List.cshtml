@using Processos_Juridicos.DTOs
@using Processos_Juridicos.Utilities
@model IEnumerable<CrimeTypeDto>
@{
    ViewData["Title"] = "Tipos de Crime";
    int count = 1;
}

<div class="container-fluid">
    <div class="mx-lg-5 my-3">

        <div class="card card-action mb-3">
            <div class="d-flex align-items-center justify-content-between">
                <h2>@ViewData["Title"]</h2>
                <a asp-controller="CrimeType" asp-action="Create" class="btn btn-primary">Inserir Tipo de Crime</a>
            </div>
        </div>

        <div class="card">
            <div id="tableLoader" class="d-flex justify-content-center my-5">
                <output class="spinner-border text-primary">
                    <span class="visually-hidden">A carregar...</span>
                </output>
            </div>

            <div id="tableContent" class="d-none">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table id="tableCrimeTypes" class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">@Html.DisplayNameFor(m => m.CrimeTypeName)</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.ToList())
                                {
                                    <tr data-id="@item.CrimeTypeId">
                                        <th scope="col">@count</th>
                                        <td data-property="name">@Html.DisplayFor(m => item.CrimeTypeName)</td>

                                        <td>
                                            <div class="d-flex gap-3">
                                                <a asp-controller="CrimeType" asp-action="Edit" asp-route-id="@item.CrimeTypeId"
                                                   data-action="access-edit-form" class="text-primary"><i class="bi bi-pencil-square"></i></a>

                                                @if (User.IsDjAdministration())
                                                {
                                                    <a class="text-danger btn-delete"
                                                       data-entity="o tipo de crime"
                                                       data-name="@item.CrimeTypeName"
                                                       data-id="@item.CrimeTypeId"
                                                       data-controller="CrimeType"
                                                       data-action="Delete">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    count++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <span>Não existem tipos de crimes.</span>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@await Html.PartialAsync("ConfirmationModals/_DeleteModal")

@section Scripts {
    <script type="module">
        import { createDataTable } from '/js/initializeDataTable.js';
        createDataTable('#tableCrimeTypes');
    </script>
}
