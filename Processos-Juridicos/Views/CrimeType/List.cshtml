@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Tipos de Acidentes";
    int count = 1;
}

@model IEnumerable<CrimeTypeDto>

<div class="text-center">
    <h1 class="display-4">Tipos de Acidente</h1>
</div>

<a asp-controller="CrimeType" asp-action="Create" class="btn btn-primary">Inserir tipo de acidente</a>

<div>
    <table id="tableCrimeTypes" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@Html.DisplayNameFor(m => m.First().CrimeTypeName)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr data-id="@item.CrimeTypeId">
                    <th scope="col">@count</th>
                    <td data-property="name" =>@Html.DisplayFor(m =>item.CrimeTypeName)</td>
                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="CrimeType" asp-action="Delete" method="post" data-action="delete">
                                <input type="hidden" name="id" value="@item.CrimeTypeId">
                                <button type="submit" class="btn btn-danger js-delete-btn"></button>
                            </form>
                            <a asp-controller="CrimeType" asp-action="Edit" asp-route-id="@item.CrimeTypeId"
                               data-action="access-edit-form" class="btn btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTable("#tableCrimeTypes");
    </script>
}
