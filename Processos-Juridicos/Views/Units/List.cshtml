@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de unidades";
    int count = 1;
}

@model IEnumerable<UnitsDTO>

<div class="text-center">
    <h1 class="display-4">Unidades</h1>
</div>

<button asp-controller ="Units" asp-action="CreateEdit" class="btn btn-primary">Inserir Unidade</button>

<div>
    <table id="tableUnits" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">@count</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.First().unit_name)</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.First().unit_code)</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.First().unit_acronym)</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.unit_code)</td>
                    <td>@Html.DisplayFor(m => item.unit_name)</td>
                    <td>@Html.DisplayFor(m => item.unit_acronym)</td>
                  
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTabe("#tableUnits");
    </script>
} 