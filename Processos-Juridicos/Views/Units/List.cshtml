@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de unidades";
    int count = 1;
}

@model IEnumerable<UnitsDTO>

<div class="text-center">
    <h1 class="display-4">Unidades</h1>
</div>

<a asp-controller="Units" asp-action="Create" class="btn btn-primary">Inserir Unidade</a>

<div>
    <table id="tableUnits" class="table table-striped-columns table-hover">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.unit_name)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.unit_code)</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.unit_acronym)</th>
                <th scope="col">@Html.DisplayNameFor(m => m.Sectors.sector_name)</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <td>@count</td>
                    <td>@Html.DisplayFor(m => item.unit_name)</td>
                    <td>@Html.DisplayFor(m => item.unit_code)</td>
                    <td>@Html.DisplayFor(m => item.unit_acronym)</td>
                    <td>@Html.DisplayFor(m => item.Sectors.sector_name)</td>
                    <td>
                        <div class="d-flex gap-2">
                            <form asp-controller="Units" asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@item.unit_id">
                                <button type="submit" class="btn btn-danger"></button>
                            </form>
                            <a asp-controller="Units" asp-action="Edit" asp-route-id="@item.unit_id" class="btn btn-warning"></a>
                        </div>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        let table = createDataTabe("#tableUnits");
    </script>
} 