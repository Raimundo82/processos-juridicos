@using Processos_Juridicos.DTOs

@{
    ViewData["Title"] = "Lista de unidades";
    int count = 1;
}

@model IEnumerable<UnitsDTO>

<div>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.FirstOrDefault().unit_name)</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.FirstOrDefault().unit_code)</th>
                <th scope="col">@Html.DisplayNameFor(m=>m.FirstOrDefault().unit_acronym)</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.ToList())
            {
                <tr>
                    <th scope="row">@count</th>
                    <td>@Html.DisplayFor(m => item.unit_code)</td>
                    <td>@Html.DisplayFor(m => item.unit_name)</td>
                    <td>@Html.DisplayFor(m => item.unit_acronym)</td>
                  
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>