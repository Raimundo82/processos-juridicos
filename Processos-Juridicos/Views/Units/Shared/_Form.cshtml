@model Processos_Juridicos.DTOs.UnitsDTO;

<div class="form-group mt-3">
    <label asp-for="unit_name" class="control-label">Nome da Unidade</label>
    <input asp-for="unit_name" class="form-control" />
    <span asp-validation-for="unit_name" class="text-danger"></span>
</div>

<div class="form-group mt-3">
    <label asp-for="unit_code" class="control-label">Código da Unidade</label>
    <input asp-for="unit_code" class="form-control" />
    <span asp-validation-for="unit_code" class="text-danger"></span>
</div>

<div class="form-group mt-3">
    <label asp-for="unit_acronym" class="control-label">Sigla da Unidade</label>
    <input asp-for="unit_acronym" class="form-control" />
    <span asp-validation-for="unit_acronym" class="text-danger"></span>
</div>

<div class="form-group mt-3">
    <label for="sectorId" class="control-label">Setor</label>
    <select asp-for="sector_Id" asp-items="ViewBag.selectors" class="form-control">
        <option value="">Selecione um Setor</option>
    </select>
    <span asp-validation-for="sector_Id" class="text-danger"></span>
</div>